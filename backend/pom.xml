<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.com.mesafranca</groupId>
  <artifactId>mesa-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Mesa Franca :: API</name>
  <description>Mesa Franca - backend da plataforma de jogos de tabuleiro virtual</description>

  <!--
    Sem framework algum nesta entrega (ADR-0008). O objetivo e provar o Game
    Core e os tres jogos antes de qualquer infraestrutura. As unicas
    dependencias do build sao de teste: JUnit, AssertJ e ArchUnit.
  -->

  <modules>
    <module>core</module>
    <module>games</module>
    <module>adapters</module>
    <module>arquitetura</module>
  </modules>

  <!--
    ADR-0008: o modulo bootstrap (Spring Boot) esta fora desta entrega.
    O diretorio api/bootstrap ainda existe no disco e deve ser removido com
    `git rm -r api/bootstrap`. Ele nao e construido.
  -->

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>

    <archunit.version>1.4.2</archunit.version>
    <jqwik.version>1.9.0</jqwik.version>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.3</assertj.version>

    <jacoco.version>0.8.14</jacoco.version>
    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>

    <!--
      Portao de cobertura (RNF-10). O valor abaixo e o piso do repositorio;
      cada modulo pode elevar, e apenas bootstrap pode zerar, por conter
      somente wiring. Ver docs/TESTING.md.
    -->
    <cobertura.linhas>0.85</cobertura.linhas>
    <cobertura.branches>0.85</cobertura.branches>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>br.com.mesafranca</groupId>
        <artifactId>mesa-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.mesafranca</groupId>
        <artifactId>mesa-adapters</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>br.com.mesafranca</groupId>
        <artifactId>mesa-ludo</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.mesafranca</groupId>
        <artifactId>mesa-love-letter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>br.com.mesafranca</groupId>
        <artifactId>mesa-uno</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>

      <!-- RNF-16: o build falha se o JDK nao for o decidido na ADR-0002. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>exigir-ambiente</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9.0,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- RNF-10 e RNF-16: cobertura como portao, nao como relatorio. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>agente</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>relatorio</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>portao</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.linhas}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.branches}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
